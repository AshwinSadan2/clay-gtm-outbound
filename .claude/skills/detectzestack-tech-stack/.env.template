# Keys the detectzestack-tech-stack skill reads from the project's .env (never fill in values here).
# Format: KEY=value (no spaces around =, no quotes). Pass --env PATH if the .env lives elsewhere.

# RapidAPI: host = the API's x-rapidapi-host (detectzestack.p.rapidapi.com, not secret);
# key = RapidAPI > Apps > Authorization (one key for every RapidAPI API).
RAPIDAPI_HOST=
RAPIDAPI_KEY=

# Supabase transaction pooler (port 6543). Needed for export-companies and load-tech.
SUPABASE_DB_URL_POOLER=

# Direct connection: only for data.py migrate (schema changes). probe_connections.sh also reports these.
SUPABASE_DB_URL_DIRECT=
SUPABASE_URL=
Blitz_APIKEY=
ATTIO_API_KEY=
