# Keys the icypeas-email-fetch skill reads from the project's .env (never fill in values here).
# Format: KEY=value (no spaces around =, no quotes). Pass --env PATH if the .env lives elsewhere.

# Icypeas API key (Icypeas app > API section). Sent alone in the Authorization header.
ICYPEAS_API_KEY=
# Icypeas API secret. Not used by the scripts: it only verifies webhooks, which this skill doesn't use.
ICYPEAS_API_SECRET=

# Supabase transaction pooler (port 6543). Needed for export-contacts and load-emails.
SUPABASE_DB_URL_POOLER=

# Used only by scripts/probe_connections.sh to report every connection (not needed for email search).
SUPABASE_URL=
SUPABASE_DB_URL_DIRECT=
Blitz_APIKEY=
ATTIO_API_KEY=
