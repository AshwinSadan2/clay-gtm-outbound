# Keys the suppression-gate skill reads from the project's .env (never fill in values here).
# Format: KEY=value (no spaces around =, no quotes). Pass --env PATH if the .env lives elsewhere.

# Attio workspace API key. Read-only scopes are enough:
# object_configuration:read, record_permission:read, list_configuration:read, list_entry:read
# Optional extra scope: user_management:read (deal owner names; not used yet)
ATTIO_API_KEY=

# Supabase transaction pooler (port 6543). Only needed for --target-supabase (gtm.companies / gtm.contacts).
SUPABASE_DB_URL_POOLER=

# Used only by scripts/probe_connections.sh to report every connection (not needed for suppression).
SUPABASE_URL=
SUPABASE_DB_URL_DIRECT=
Blitz_APIKEY=
