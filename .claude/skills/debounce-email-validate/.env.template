# Keys the debounce-email-validate skill reads from the project's .env (never fill in values here).
# Format: KEY=value (no spaces around =, no quotes). Pass --env PATH if the .env lives elsewhere.

# Debounce API key (app.debounce.io/api, 13 characters). Sent as the api= query parameter.
DEBOUNCE_API_KEY=

# Supabase transaction pooler (port 6543). Needed for load-validation.
SUPABASE_DB_URL_POOLER=

# Used only by scripts/probe_connections.sh to report every connection (not needed for validation).
SUPABASE_URL=
SUPABASE_DB_URL_DIRECT=
Blitz_APIKEY=
ATTIO_API_KEY=
